<Window x:Class="WinNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch · Setări" Width="480" Height="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Background="#F6F7F9">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B626D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Border" x:Key="Section">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#E3E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="False">
            <TextBlock x:Name="Msg" DockPanel.Dock="Left" Foreground="#B04A00" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
            <Button DockPanel.Dock="Right" Content="Salvează" Width="96" Height="30" Click="Save_Click" IsDefault="True"/>
            <Button DockPanel.Dock="Right" Content="Renunță" Width="96" Height="30" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Ce apare în standby"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Bifează până la 5. Ordinea de sus în jos e ordinea de pe notch: prima jumătate stă în stânga camerei, restul în dreapta. Timer-ul Pomodoro se adaugă singur cât rulează."/>
                        <StackPanel x:Name="WidgetRows"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Comportament"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Se deschide la hover după" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Slider x:Name="DwellSlider" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="DwellSlider_ValueChanged"/>
                            <TextBlock x:Name="DwellText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Poziție" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PosBox" Grid.Column="1">
                                <ComboBoxItem Tag="left" Content="Stânga"/>
                                <ComboBoxItem Tag="center" Content="Centru"/>
                                <ComboBoxItem Tag="right" Content="Dreapta"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Peste jocuri / fullscreen" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FsBox" Grid.Column="1">
                                <ComboBoxItem Tag="alerts" Content="Se ascunde, apare doar pentru alerte"/>
                                <ComboBoxItem Tag="visible" Content="Rămâne mereu vizibil"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Se micșorează singur după" VerticalAlignment="Center"/>
                            <ComboBox x:Name="MiniBox" Grid.Column="1">
                                <ComboBoxItem Tag="0" Content="Niciodată"/>
                                <ComboBoxItem Tag="5" Content="5 secunde"/>
                                <ComboBoxItem Tag="10" Content="10 secunde"/>
                                <ComboBoxItem Tag="30" Content="30 de secunde"/>
                                <ComboBoxItem Tag="60" Content="1 minut"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mărimea notch-ului deschis" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ComboBox x:Name="ScaleBox" Grid.Column="1">
                                <ComboBoxItem Tag="0" Content="Automat (după monitor)"/>
                                <ComboBoxItem Tag="1" Content="100%"/>
                                <ComboBoxItem Tag="1.1" Content="110%"/>
                                <ComboBoxItem Tag="1.2" Content="120%"/>
                                <ComboBoxItem Tag="1.3" Content="130%"/>
                                <ComboBoxItem Tag="1.45" Content="145%"/>
                                <ComboBoxItem Tag="1.6" Content="160%"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scurtătura Command Bar" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ComboBox x:Name="CmdKeyBox" Grid.Column="1">
                                <ComboBoxItem Tag="space" Content="Win+Alt+Space"/>
                                <ComboBoxItem Tag="k" Content="Win+Alt+K"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="CmdKeyHint" Style="{StaticResource Hint}" Margin="170,4,0,0"/>
                        <CheckBox x:Name="SlimBox" Margin="0,12,0,0" Content="Mic peste ferestre maximizate (tab-uri, bara de titlu)"/>
                        <CheckBox x:Name="TempsBox" Margin="0,8,0,0" Content="Citește temperaturile PC-ului"/>
                        <TextBlock x:Name="TempsHint" Style="{StaticResource Hint}" Margin="22,2,0,0"
                                   Text="Pentru temperatura procesorului e nevoie și de driverul gratuit PawnIO (pawnio.eu)."/>
                        <CheckBox x:Name="StartBox" Margin="0,4,0,0" Content="Pornește odată cu Windows"/>
                        <CheckBox x:Name="UpdateBox" Margin="0,8,0,0" Content="Caută singur versiuni noi (te întreabă în notch înainte să instaleze)"/>
                        <CheckBox x:Name="BetaBox" Margin="22,6,0,0" Content="Canal beta (versiuni de test)"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="44,2,0,0"
                                   Text="Primești și versiunile de test, înaintea celor finale. Pot avea probleme; dacă una se închide des, WinNotch revine singur la versiunea anterioară."/>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                            <Button x:Name="UpdateNowBtn" Content="Caută acum" Padding="10,3" Click="UpdateNow_Click"/>
                            <TextBlock x:Name="UpdateStatus" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Foreground="#5B626D"/>
                        </StackPanel>
                        <StackPanel x:Name="StartUpdatePanel" Margin="22,6,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="StartUpdateHint" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <Button x:Name="StartUpdateBtn" Content="Actualizează copia de pornire" HorizontalAlignment="Left" Padding="10,4" Click="StartUpdate_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Acasă și sănătate"/>
                        <CheckBox x:Name="LyricsBox" Margin="0,6,0,0" Content="Arată versurile piesei (de la LRCLIB, gratuit)"/>
                        <CheckBox x:Name="EyeBox" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Text="Pauză pentru ochi: la fiecare 20 de minute la PC, 20 de secunde de privit în depărtare"/>
                        </CheckBox>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="RamAlertBox" VerticalAlignment="Center" Content="Alertă când memoria RAM trece de" Margin="0,0,8,0"/>
                            <ComboBox x:Name="RamPctBox" Grid.Column="1" Width="80" HorizontalAlignment="Left">
                                <ComboBoxItem Tag="75" Content="75%"/>
                                <ComboBoxItem Tag="80" Content="80%"/>
                                <ComboBoxItem Tag="85" Content="85%"/>
                                <ComboBoxItem Tag="90" Content="90%"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Îți arată cine consumă cel mai mult și îți propune eliberarea memoriei. Cel mult o dată la 15 minute, niciodată peste un joc sau un video pe tot ecranul."/>
                        <TextBlock Style="{StaticResource H}" Text="Calendar" Margin="0,14,0,4"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Lipește link-ul secret iCal al calendarului tău. Google Calendar: Setări → calendarul tău → „Adresa secretă în format iCal”. Outlook: Setări → Calendare partajate → Publică un calendar → link ICS."/>
                        <TextBox x:Name="IcsBox" Padding="4,3"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Tab-uri din browser"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Windows vede tot browserul ca o singură aplicație. Cu extensia WinNotch, fiecare tab care redă sunet (YouTube, Reels, YouTube Music…) apare separat și îl poți opri, pune pe pauză sau da mai încet. Merge în Chrome, Edge, Brave, Opera și Vivaldi. Nimic nu iese din calculator."/>
                        <CheckBox x:Name="TabsBox" Content="Arată fiecare tab separat"/>
                        <TextBlock x:Name="ExtStatus" Margin="0,8,0,8" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Instalare, o singură dată pentru fiecare browser:&#x0a;1. Apasă „Deschide extensiile” mai jos (sau scrie chrome://extensions în bara de adrese).&#x0a;2. Pornește „Modul dezvoltator” (Developer mode), dreapta sus.&#x0a;3. Apasă „Încarcă extensia neîmpachetată” (Load unpacked) și alege folderul extensiei. Calea e deja copiată: o lipești cu Ctrl+V.&#x0a;&#x0a;Ai instalat-o înainte de versiunea 0.5? Șterge-o (Remove) și încarc-o din nou: acum are un ID fix, iar WinNotch acceptă doar extensia lui."/>
                        <WrapPanel>
                            <Button Content="Deschide extensiile (Chrome)" Padding="10,4" Margin="0,0,8,6" Click="OpenChromeExt_Click"/>
                            <Button Content="Deschide extensiile (Edge)" Padding="10,4" Margin="0,0,8,6" Click="OpenEdgeExt_Click"/>
                            <Button Content="Arată folderul extensiei" Padding="10,4" Margin="0,0,8,6" Click="OpenExtFolder_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Spații de lucru"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Le creezi din notch: Unelte → „+ salvează aranjarea de acum”. Aici le redenumești sau le ștergi."/>
                        <StackPanel x:Name="WorkspaceRows"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Culoare accent"/>
                        <WrapPanel x:Name="AccentPanel" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Vremea"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Orașul și coordonatele lui (le găsești pe Google Maps: click dreapta pe hartă)."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Oraș" Foreground="#5B626D" Margin="0,0,0,3"/>
                            <TextBlock Grid.Column="2" Text="Latitudine" Foreground="#5B626D" Margin="0,0,0,3"/>
                            <TextBlock Grid.Column="4" Text="Longitudine" Foreground="#5B626D" Margin="0,0,0,3"/>
                            <TextBox x:Name="CityBox" Grid.Row="1" Padding="4,3"/>
                            <TextBox x:Name="LatBox" Grid.Row="1" Grid.Column="2" Padding="4,3"/>
                            <TextBox x:Name="LonBox" Grid.Row="1" Grid.Column="4" Padding="4,3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Pagina după context"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Pe ce pagină se deschide notch-ul după ce faci acum. „—” = nicio schimbare (rămâne pagina de data trecută). O pagină aleasă de tine în notch e păstrată 10 minute; o pagină ascunsă sau ștearsă e sărită. Merge cu „Pagina după context” pornită în „Funcții noi”, mai jos."/>
                        <StackPanel x:Name="ContextPageRows"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Smart Clipboard"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Widget-ul Clipboard recunoaște ce copiezi (JSON, link, culoare, e-mail, IP, cale, JWT, telefon) și îți dă butoane mici: formatează, curăță link-ul de urmărire, decodează. Parolele copiate din managerele de parole sunt ignorate, iar nimic din ce copiezi nu ajunge în log. Merge cu „Smart Clipboard” pornit în „Funcții noi”, mai jos."/>
                        <CheckBox x:Name="ClipPeekBox" Margin="0,4,0,0">
                            <TextBlock TextWrapping="Wrap" Text="Un mesaj scurt în pastilă când copiezi un JSON, un link cu urmărire sau un token JWT (doar cu „Manager de activități” pornit)"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H}" Text="Funcții noi (experimental)"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Funcții încă în lucru. Le pornești sau le oprești aici, fără repornire, dar schimbarea se aplică abia când apeși „Salvează”, mai jos. Una care dă erori repetate se oprește singură. Cele marcate „pornită implicit” merg deja: bifarea lor nu schimbă nimic."/>
                        <TextBlock x:Name="SafeModeNote" Style="{StaticResource Hint}" Foreground="#B04A00" Visibility="Collapsed"
                                   Text="Mod sigur: WinNotch a pornit cu --safe-mode, așa că funcțiile Experimental și Beta sunt oprite până la următoarea pornire normală. Alegerile de aici se păstrează."/>
                        <StackPanel x:Name="FeatureRows"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
