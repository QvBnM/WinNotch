{
  "manifest_version": 3,
  "key": "",
  "name": "WinNotch - tab-uri cu sunet",
  "version": "1.6",
  "description": "Arata in WinNotch fiecare tab care reda sunet (YouTube, Reels, YouTube Music...) si il lasa sa fie oprit, pus pe pauza sau dat mai incet.",
  "permissions": [
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}