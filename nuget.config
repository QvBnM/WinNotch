<?xml version="1.0" encoding="utf-8"?>
<!-- Makes sure packages come from nuget.org even if the machine has no package source configured. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
