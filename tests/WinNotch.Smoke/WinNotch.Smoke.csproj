<Project Sdk="Microsoft.NET.Sdk">
  <!-- Smoke tests (P02): start the published WinNotch.exe in smoke mode and drive it through UI Automation (FlaUI).
       Run in CI (windows-latest) after the build; see .github/workflows/ci.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- P14: a small window of the test itself, the "previous window" the Command Bar gives the keyboard back to -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- Main, the order of the checks and the shared helpers; the checks of each area in their own file (one partial class) -->
    <Compile Include="SmokeProgram.cs" />
    <Compile Include="SmokeAlerts.cs" />
    <Compile Include="SmokeCommandBar.cs" />
    <Compile Include="SmokeContext.cs" />
    <Compile Include="SmokeClipboard.cs" />
    <Compile Include="SmokeShelf.cs" />
    <Compile Include="SmokeAudio.cs" />
    <Compile Include="SmokeB1.cs" />
    <!-- the same status format and file names as the app -->
    <Compile Include="..\..\Features\Smoke\SmokeMode.cs" />
  </ItemGroup>
</Project>
